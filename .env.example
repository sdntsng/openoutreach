# OpenOutreach local/production secrets — never commit real values.
COLD_CLI_DATABASE_URL=postgresql://openoutreach:openoutreach@localhost:5433/openoutreach?sslmode=disable
# IMPORTANT: use a direct Postgres URL for tick (no PgBouncer transaction pooler, no Hyperdrive).
DATABASE_URL=
OPENOUTREACH_WORKSPACE_ID=default
OPENOUTREACH_MOCK_GMAIL=1
CREDENTIAL_ENCRYPTION_KEY=local-dev-encryption-key-change-me
INTERNAL_CONTAINER_TOKEN=local-internal-token
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/accounts/google/oauth/callback
MCP_BEARER_TOKEN=
LISTEN_ADDR=:8080
