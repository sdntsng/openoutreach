# OpenOutreach local/production secrets — never commit real values.
COLD_CLI_DATABASE_URL=postgresql://openoutreach:openoutreach@localhost:5433/openoutreach?sslmode=disable
# IMPORTANT: use a direct Postgres URL for tick (no PgBouncer transaction pooler, no Hyperdrive).
DATABASE_URL=
OPENOUTREACH_WORKSPACE_ID=default
OPENOUTREACH_MOCK_GMAIL=1
CREDENTIAL_ENCRYPTION_KEY=local-dev-encryption-key-change-me
INTERNAL_CONTAINER_TOKEN=local-internal-token
PUBLIC_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/accounts/google/oauth/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
FEATURE_GMAIL=1
FEATURE_SMTP_IMAP=1
FEATURE_MICROSOFT=0
FEATURE_APOLLO=1
FEATURE_CLAY=1
FEATURE_WEBHOOK=1
FEATURE_SHEETS=1
# Sending/integration forms default ON in the app. Set =0 only to hide a provider.
FEATURE_RESEND=1
FEATURE_SES=1
FEATURE_CF_EMAIL=1
FEATURE_HUNTER=1
FEATURE_WARMUP=1
AUTH_MODE=local_noauth
TRACKING_HMAC_SECRET=
MCP_BEARER_TOKEN=
LISTEN_ADDR=:8080
