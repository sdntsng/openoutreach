{
  "name": "openoutreach",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "OutreachContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTREACH",
        "class_name": "OutreachContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OutreachContainer"]
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp/*",
      "/internal/*",
      "/t/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_BASE_URL": "http://localhost:8787"
  },
  "env": {
    "production": {
      "workers_dev": false,
      "routes": [
        {
          "pattern": "__OPENOUTREACH_HOSTNAME__",
          "custom_domain": true
        }
      ],
      "vars": {
        "PUBLIC_BASE_URL": "https://__OPENOUTREACH_HOSTNAME__"
      },
      "containers": [
        {
          "class_name": "OutreachContainer",
          "image": "registry.cloudflare.com/__CLOUDFLARE_ACCOUNT_ID__/outreachd:__IMAGE_TAG__",
          "max_instances": 1,
          "instance_type": "basic"
        }
      ]
    }
  }
}
