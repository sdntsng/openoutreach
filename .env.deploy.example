# Copy to .env.deploy and fill in values, then run: ./scripts/deploy-cf.sh
# Never commit .env.deploy (gitignored).

# Storage: d1 (Cloudflare D1, default) or postgres
STORAGE=d1

# Required only when STORAGE=postgres — direct connection, no transaction pooler.
# Neon: use the direct connection string (not *-pooler*).
# Supabase: port 5432 / direct mode, not transaction pooler (6543).
# DATABASE_URL=

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft 365 / Outlook (optional) ---
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# CREDENTIAL_ENCRYPTION_KEY=
# INTERNAL_CONTAINER_TOKEN=
# MCP_BEARER_TOKEN=
# TRACKING_HMAC_SECRET=

# --- Set after first deploy (or use your custom domain) ---
# PUBLIC_BASE_URL=https://openoutreach.<account>.workers.dev

OPENOUTREACH_WORKSPACE_ID=default

# Dashboard auth: cloudflare_access (default) | hosted | local_noauth
AUTH_MODE=cloudflare_access

# Required when AUTH_MODE=cloudflare_access — Access application AUD tag.
# Set automatically by: ./scripts/setup-cf-access.sh
# CF_ACCESS_AUD=

# One-time CLI Access setup (needs Access: Apps and Policies Write — not wrangler login OAuth):
# CLOUDFLARE_API_TOKEN=

# Optional: restrict Access / Better Auth signup to these emails (comma-separated).
# AUTH_ALLOWED_EMAILS=you@example.com
